{
  "name": "Resell Ready",
  "short_name": "Resell Ready",
  "start_url": "./add.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f8",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "lib/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "lib/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./add.html?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "media", "accept": ["image/*", "video/*"] }] }
  }
}
